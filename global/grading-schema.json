{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dwes/grading-schema.json",
  "title": "DWES Microrepte Grading Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "student",
    "commit",
    "final_score_over_10",
    "provisional",
    "dimension_scores",
    "ra_scores",
    "strengths",
    "weaknesses",
    "blocking_flags",
    "teacher_review_required",
    "confidence",
    "short_feedback_md"
  ],
  "properties": {
    "challenge_id": {
      "type": "string",
      "minLength": 1
    },
    "student": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "final_score_over_10": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "provisional": {
      "type": "boolean"
    },
    "dimension_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "max_score",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "max_score": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ra_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ra_id",
          "score",
          "assessed_ca",
          "reason"
        ],
        "properties": {
          "ra_id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "assessed_ca": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teacher_review_required": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "short_feedback_md": {
      "type": "string"
    },
    "repte_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_score",
        "core_ready",
        "reason",
        "evidence",
        "presentation_checks"
      ],
      "properties": {
        "proposed_score": {
          "type": "number",
          "enum": [
            0,
            0.25,
            0.5,
            0.75,
            1
          ]
        },
        "core_ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "presentation_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
